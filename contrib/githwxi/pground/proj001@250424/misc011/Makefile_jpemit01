########################################################################
########################################################################
# Makefile for misc011
########################################################################
########################################################################
CAT=cat
BUN=bun
ECHO=echo
NODE=node
PRINTF=printf
PYTHON=python3
########################################################################
########################################################################
all:: fact000
all:: fibo000
all:: misc011
########################################################################
testall:: \
fact000; $(NODE) OUTS/$<_out.js
testall:: \
fibo000; $(NODE) OUTS/$<_out.js
testall:: \
misc011; $(NODE) OUTS/$<_out.js
testall:: \
JP_misc011; $(PYTHON) OUTS/$<_out.py
########################################################################
########################################################################
clean:: ; rm -f *~
cleanall:: ; rm -f *~
cleanall:: ; rm -f OUTS/*~
cleanall:: ; rm -f OUTS/*_out.js
cleanall:: ; rm -f OUTS/*_out.py
cleanall:: ; rm -f OUTS/*_out?.js
########################################################################
########################################################################
XATSHOME=./../../../../../../XATSHOME
########################################################################
#
XATS2JSD=$(XATSHOME)/xassets/JS/xats2js
XATS2PYD=$(XATSHOME)/xassets/PY/xats2py
#
XATS2JS_JSEMIT01=\
$(XATSHOME)/xassets/JS/xats2js/xats2js_jsemit01_ats2_opt1.js
XATS2JS_JSEMIT01=\
$(XATSHOME)/xassets/JS/xats2js/xats2js_jsemit01_ats3_opt1.js
#
JP_XATS2PY_PYEMIT01=\
$(XATSHOME)/xassets/JS/xats2py/xats2py_pyemit01_ats3_opt1.js
#
########################################################################
########################################################################
fact000:: ; \
$(PRINTF) "// %s\n" "`date`" > OUTS/$@_out.js
fact000:: ; \
$(CAT) $(XATS2JSD)/runtime/xats2js_js1emit.js >> OUTS/$@_out.js
fact000:: ; \
$(CAT) $(XATS2JSD)/runtime/srcgen2_precats.js >> OUTS/$@_out.js
fact000:: ; \
$(CAT) $(XATS2JSD)/runtime/srcgen2_prelude.js >> OUTS/$@_out.js
fact000:: fact000.dats; \
$(NODE) --stack-size=8801 $(XATS2JS_JSEMIT01) $< >> OUTS/$@_out.js
########################################################################
fibo000:: ; \
$(PRINTF) "// %s\n" "`date`" > OUTS/$@_out.js
fibo000:: ; \
$(CAT) $(XATS2JSD)/runtime/xats2js_js1emit.js >> OUTS/$@_out.js
fibo000:: ; \
$(CAT) $(XATS2JSD)/runtime/srcgen2_precats.js >> OUTS/$@_out.js
fibo000:: ; \
$(CAT) $(XATS2JSD)/runtime/srcgen2_prelude.js >> OUTS/$@_out.js
fibo000:: fibo000.dats; \
$(NODE) --stack-size=8801 $(XATS2JS_JSEMIT01) $< >> OUTS/$@_out.js
########################################################################
misc011:: ; \
$(PRINTF) "// %s\n" "`date`" > OUTS/$@_out.js
misc011:: ; \
$(CAT) $(XATS2JSD)/runtime/xats2js_js1emit.js >> OUTS/$@_out.js
misc011:: ; \
$(CAT) $(XATS2JSD)/runtime/srcgen2_precats.js >> OUTS/$@_out.js
misc011:: ; \
$(CAT) $(XATS2JSD)/runtime/srcgen2_prelude.js >> OUTS/$@_out.js
misc011:: misc011.dats; \
$(NODE) --stack-size=8801 $(XATS2JS_JSEMIT01) $< >> OUTS/$@_out.js
########################################################################
JP_misc011:: ; \
$(PRINTF) \
"## %s\n" "`date`" > OUTS/$@_out.py
JP_misc011:: ; \
$(PRINTF) \
"########################" >> OUTS/$@_out.py
JP_misc011:: ; \
$(PRINTF) \
"########################" >> OUTS/$@_out.py
JP_misc011:: ; \
$(PRINTF) \
"########################\n" >> OUTS/$@_out.py
JP_misc011:: ; \
$(PRINTF) \
"import sys\n%s\n" \
"sys.setrecursionlimit(10000)" >> OUTS/$@_out.py
JP_misc011:: ; \
$(CAT) $(XATS2PYD)/runtime/xats2py_py1emit.py >> OUTS/$@_out.py
JP_misc011:: ; \
$(CAT) $(XATS2PYD)/runtime/srcgen2_precats.py >> OUTS/$@_out.py
JP_misc011:: ; \
$(CAT) $(XATS2PYD)/runtime/srcgen2_prelude.py >> OUTS/$@_out.py
JP_misc011:: misc011.dats; \
$(NODE) --stack-size=8801 $(JP_XATS2PY_PYEMIT01) $< >> OUTS/$@_out.py
########################################################################
misc011_out1:: ; \
npx google-closure-compiler -W QUIET \
  --compilation_level SIMPLE --js=OUTS/misc011_out.js --js_output_file=OUTS/misc011_out1.js
misc011_out2:: ; \
npx google-closure-compiler -W QUIET \
  --compilation_level ADVANCED --js=OUTS/misc011_out.js --js_output_file=OUTS/misc011_out2.js
########################################################################
##################### end of [Makefile_jsemit01] #######################
