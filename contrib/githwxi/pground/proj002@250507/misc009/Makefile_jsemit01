# Makefile for misc009
########################################################################
########################################################################
CAT=cat
CPF=cp -f
ECHO=echo
NODE=node
PRINTF=printf
PYTHON=python3
########################################################################
########################################################################
all:: embedded
########################################################################
clean:: ; rm -f *~
########################################################################
cleanall:: ; rm -f *~
cleanall:: ; rm -f OUTS/JS_StreamDemo_cats.js
cleanall:: ; rm -f OUTS/JS_StreamDemo_dats.js
########################################################################
XATSHOME=./../../../../../../XATSHOME
########################################################################
#
XATS2JSD=$(XATSHOME)/xassets/JS/xats2js
#
XATS2JS_JSEMIT01=\
$(XATSHOME)/xassets/JS/xats2js/bin/xats2js_jsemit01_ats2_opt1.js
XATS2JS_JSEMIT01=\
$(XATSHOME)/xassets/JS/xats2js/bin/xats2js_jsemit01_ats3_opt1.js
#
########################################################################
########################################################################
embedded:: ; \
$(CPF) JS_StreamDemo.cats OUTS/JS_StreamDemo_cats.js
embedded:: ; \
$(PRINTF) "// %s\n" "`date`" > OUTS/JS_StreamDemo_dats.js
embedded:: ; \
$(CAT) $(XATS2JSD)/runtime/xats2js_js1emit.js >> OUTS/JS_StreamDemo_dats.js
embedded:: ; \
$(CAT) $(XATS2JSD)/runtime/srcgen2_precats.js >> OUTS/JS_StreamDemo_dats.js
embedded:: ; \
$(CAT) $(XATS2JSD)/runtime/srcgen2_prelude.js >> OUTS/JS_StreamDemo_dats.js
embedded:: StreamDemo
StreamDemo: StreamDemo.dats; \
$(NODE) --stack-size=8802 $(XATS2JS_JSEMIT01) $< >> OUTS/JS_StreamDemo_dats.js
embedded:: JS_StreamDemo
JS_StreamDemo: JS_StreamDemo.dats; \
$(NODE) --stack-size=8802 $(XATS2JS_JSEMIT01) $< >> OUTS/JS_StreamDemo_dats.js
