$(CAT) $(XATS2PYD)/runtime/srcgen2_prelude.py >> OUTS/$@_out.py
test:: ggrph
ggrph: ggrph.dats; \
$(NODE) --stack-size=8802 $(JP_XATS2PY_PYEMIT01) $< >> OUTS/test_out.py
test:: doublets
doublets: doublets.dats; \
$(NODE) --stack-size=8802 $(JP_XATS2PY_PYEMIT01) $< >> OUTS/test_out.py
