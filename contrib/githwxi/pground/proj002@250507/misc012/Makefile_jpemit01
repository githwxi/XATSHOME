# HX: [ats2] is needed for TRO
JP_XATS2PY_PYEMIT01=\
$(XATSHOME)/xassets/JS/xats2py/xats2py_pyemit01_ats2_opt1.js
#
########################################################################
########################################################################
test:: ; \
$(PRINTF) \
"#!/usr/bin/env python3\n" > OUTS/$@_out.py
test:: ; \
$(PRINTF) "## %s\n" "`date`" >> OUTS/$@_out.py
test:: ; \
$(PRINTF) "import sys\nimport requests\n" >> OUTS/$@_out.py
test:: ; \
$(CAT) $(XATS2PYD)/runtime/xats2py_py1emit.py >> OUTS/$@_out.py
