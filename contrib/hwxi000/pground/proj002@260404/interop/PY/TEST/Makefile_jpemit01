########################################################################
########################################################################
# Makefile for misc011
########################################################################
########################################################################
CAT=cat
BUN=bun
ECHO=echo
NODE=node
PRINTF=printf
PYTHON=python3
########################################################################
########################################################################
all:: test00
########################################################################
########################################################################
testall::
testall:: test00; $(PYTHON) OUTS/$<_out.py
testall:: test01; $(PYTHON) OUTS/$<_out.py
########################################################################
########################################################################
clean:: ; rm -f *~
cleanall:: ; rm -f *~
cleanall:: ; rm -f OUTS/*~
cleanall:: ; rm -f OUTS/*_out.py
########################################################################
########################################################################
XATSHOME=\
./../../../../../../../../XATSHOME
########################################################################
#
XATS2PYD=$(XATSHOME)/xassets/PY/xats2py
#
# HX: [ats2] is needed for TRO
PYEMIT01=npx @npmhwxi/xats2py-pyemit01-ats2
JP_XATS2PY_PYEMIT01=\
$(XATSHOME)/xassets/JS/xats2py/bin/xats2py_pyemit01_ats2_opt1.js
#
########################################################################
########################################################################
test00:: ; \
$(PRINTF) "## %s\n" "`date`" > OUTS/$@_out.py
test00:: ; \
$(CAT) \
$(XATS2PYD)/runtime/xats2py_py1emit.py >> OUTS/$@_out.py
test00:: ; \
$(CAT) \
$(XATS2PYD)/runtime/srcgen2_precats.py >> OUTS/$@_out.py
test00:: ; \
$(CAT) \
$(XATS2PYD)/runtime/srcgen2_prelude.py >> OUTS/$@_out.py
# test00:: sorting.dats; \
# $(NODE) \
--stack-size=8801 $(JP_XATS2PY_PYEMIT01) $< >> OUTS/$@_out.py
test00:: ; $(PYEMIT01) test00_interop.dats --_XATS2PY_ >> OUTS/$@_out.py
########################################################################
test01:: ; \
$(PRINTF) "## %s\n" "`date`" > OUTS/$@_out.py
test01:: ; \
$(CAT) \
$(XATS2PYD)/runtime/xats2py_py1emit.py >> OUTS/$@_out.py
test01:: ; \
$(CAT) \
$(XATS2PYD)/runtime/srcgen2_precats.py >> OUTS/$@_out.py
test01:: ; \
$(CAT) \
$(XATS2PYD)/runtime/srcgen2_prelude.py >> OUTS/$@_out.py
test01:: ; $(CAT) ./../CATS/system.cats >> OUTS/$@_out.py
# test01:: sorting.dats; \
# $(NODE) \
--stack-size=8801 $(JP_XATS2PY_PYEMIT01) $< >> OUTS/$@_out.py
test01:: ; $(PYEMIT01) test01_interop.dats --_XATS2PY_ >> OUTS/$@_out.py
